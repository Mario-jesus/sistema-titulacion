{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "../../",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "../../libs/backend/core/src/**/*.ts",
    "../../libs/backend/shared/src/**/*.ts",
    "../../libs/backend/seeds/src/**/*.ts",
    "../../libs/backend/users/src/**/*.ts",
    "../../libs/backend/auth/src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ]
}
