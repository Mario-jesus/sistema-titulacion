    },
    {
      "path": "../../libs/backend/modalities/tsconfig.lib.json"
    },
    {
      "path": "../../libs/backend/generations/tsconfig.lib.json"
    },
    {
      "path": "../../libs/backend/core/tsconfig.lib.json"
    },
    {
