# =============================================================================
# Sistema Titulación — Servidor (variables de entorno)
# Copiar a .env en esta misma carpeta y ajustar según el entorno.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1

# MongoDB (ODM: Mongoose)
# Opción A: URI completo (tiene prioridad si está definido)
# MONGODB_URI=mongodb://usuario:password@localhost:27017/nombre-db?authSource=admin

# Opción B: variables por separado (se arma MONGODB_URI automáticamente)
MONGODB_HOST=mongodb://localhost:27017
DATABASE_NAME=sistema-titulacion
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# CORS: origen(es) permitidos, separados por coma, o * para permitir todos
# Por defecto: http://localhost:4200 (cliente Vite en dev con NX)
# CORS_ORIGIN=http://localhost:4200
# CORS_ORIGIN=http://localhost:4200,https://mi-app.com

# JWT (autenticación)
# JWT_SECRET=change-me-in-production
# JWT_ACCESS_EXPIRES=3600
# JWT_REFRESH_EXPIRES=604800

# Admin solo desde .env (npm run seed:admin): obligatorias las tres.
# Seed completo con usuarios de prueba: npm run seed:users (admin desde .env opcional; si falta alguna variable, admin por defecto).
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me

# Logging (Pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Backups (MVP: almacenamiento local + cifrado simétrico AES-256-GCM)
BACKUP_STORAGE_PATH=./var/backups
BACKUP_TMP_PATH=./var/backups/tmp
# Debe decodificar exactamente a 32 bytes:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY_BASE64=
BACKUP_RETENTION_DAYS=30
# Límite máximo de archivo subido (/backups/upload), por defecto 1GB
BACKUP_MAX_UPLOAD_BYTES=1073741824
