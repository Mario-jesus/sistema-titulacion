# =============================================================================
# Sistema Titulación — Servidor (variables de entorno)
# Copiar a .env en esta misma carpeta y ajustar según el entorno.
# =============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1

# MongoDB (ODM: Mongoose)
# Opción A: URI completo (tiene prioridad si está definido)
# MONGODB_URI=mongodb://usuario:password@localhost:27017/nombre-db?authSource=admin

# Opción B: variables por separado (se arma MONGODB_URI automáticamente)
MONGODB_HOST=mongodb://localhost:27017
DATABASE_NAME=sistema-titulacion
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin

# CORS: origen(es) permitidos, separados por coma, o * para permitir todos
# Por defecto: http://localhost:5173 (cliente Vite en dev)
# CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173,https://mi-app.com

# JWT (autenticación)
# JWT_SECRET=change-me-in-production
# JWT_ACCESS_EXPIRES=3600
# JWT_REFRESH_EXPIRES=604800

# Logging (Pino): fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
